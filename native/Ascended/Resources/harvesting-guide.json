    {
      "resource": "Raw Meat",
      "aliases": [
        "Meat",
        "Dino Corpse"
      ],
      "summary": "For a hand harvest, choose Metal Pick over Metal Hatchet. A meat-harvesting carnivore is the practical bulk option.",
      "tools": [
        {
          "name": "Metal Pick",
          "role": "Favors meat when harvesting a corpse."
        },
        {
          "name": "Stone Pick",
          "role": "Early pick option before metal tools."
        },
        {
          "name": "Metal Hatchet",
          "role": "Harvests meat too, but favors hide."
        }
      ],
      "creatures": [
        {
          "name": "Rex",
          "role": "Bulk corpse harvesting."
        },
        {
          "name": "Carnotaurus",
          "role": "Meat harvesting option."
        },
        {
          "name": "Allosaurus",
          "role": "Meat harvesting option."
        },
        {
          "name": "Giganotosaurus",
          "role": "Bulk option once available and safely tamed."
        },
        {
          "name": "Argentavis",
          "role": "Mobile corpse-harvesting option."
        }
      ],
      "targets": [
        "Ordinary land-creature corpses",
        "Phiomia: useful early meat and hide; it flees when attacked"
      ],
      "cautions": [
        "Yield varies with harvester stats, tool quality and harvest settings.",
        "Fish meat and prime meat require their own source choices."
      ],
      "weightReductions": [],
      "sourceURLs": [
        "https://ark.wiki.gg/wiki/Raw_Meat",
        "https://ark.wiki.gg/wiki/Metal_Pick",
        "https://ark.wiki.gg/wiki/Metal_Hatchet",
        "https://ark.wiki.gg/wiki/Hide"
      ],
      "verifiedAt": "2026-10-07"
    },
